<?xml version="1.0" encoding="utf-8"?>
<!-- MU-FLAC expanded notification: art + text + format pill, then heart / prev / play / next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mu_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mu_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/mu_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFF5F5F7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mu_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FF8E8E93"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mu_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/mu_pill"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:textColor="#FF161618"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mu_heart"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/mu_btn"
            android:contentDescription="Favorite"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mu_ic_heart_outline" />

        <ImageButton
            android:id="@+id/mu_prev"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="18dp"
            android:background="@drawable/mu_btn"
            android:contentDescription="Previous"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mu_ic_prev" />

        <ImageButton
            android:id="@+id/mu_play"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/mu_btn_primary"
            android:contentDescription="Play or pause"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mu_ic_pause" />

        <ImageButton
            android:id="@+id/mu_next"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/mu_btn"
            android:contentDescription="Next"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mu_ic_next" />
    </LinearLayout>
</LinearLayout>
