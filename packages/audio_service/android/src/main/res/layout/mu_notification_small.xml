<?xml version="1.0" encoding="utf-8"?>
<!-- MU-FLAC collapsed notification: art, title/artist, prev / play / next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mu_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/mu_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/mu_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFF5F5F7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mu_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FF8E8E93"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mu_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/mu_btn"
        android:contentDescription="Previous"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mu_ic_prev" />

    <ImageButton
        android:id="@+id/mu_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/mu_btn_primary"
        android:contentDescription="Play or pause"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mu_ic_pause" />

    <ImageButton
        android:id="@+id/mu_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/mu_btn"
        android:contentDescription="Next"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mu_ic_next" />
</LinearLayout>
