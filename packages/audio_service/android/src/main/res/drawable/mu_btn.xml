<?xml version="1.0" encoding="utf-8"?>
<!-- Raised neumorphic round button: soft dark shadow bottom-right + charcoal gradient face. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp">
        <shape android:shape="oval"><solid android:color="#80000000"/></shape>
    </item>
    <item android:right="2dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FF323235" android:endColor="#FF222224"/>
            <stroke android:width="1dp" android:color="#14FFFFFF"/>
        </shape>
    </item>
</layer-list>
